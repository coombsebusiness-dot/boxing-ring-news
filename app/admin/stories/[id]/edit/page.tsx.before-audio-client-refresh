import { notFound, redirect } from "next/navigation";
import Link from "next/link";
import AdminHeader from "@/components/admin/AdminHeader";
import StoryEditor from "@/components/admin/stories/StoryEditor";
import {
  generateAudioForStory,
  syncAudioForStory,
  updateStory,
} from "./actions";
import { createClient } from "@/lib/supabase/server";

type PageProps = {
  params: Promise<{
    id: string;
  }>;

  searchParams: Promise<{
    saved?: string;
    audio?: string;
  }>;
};

export default async function EditStoryPage({
  params,
  searchParams,
}: PageProps) {
  const { id } = await params;
  const {
    saved,
    audio,
  } = await searchParams;

  const supabase =
    await createClient();

  const {
    data: { user },
  } = await supabase.auth.getUser();

  if (!user) {
    redirect("/admin/login");
  }

  const {
    data: profile,
  } = await supabase
    .from("newsroom_users")
    .select("role")
    .eq("user_id", user.id)
    .eq("is_active", true)
    .maybeSingle();

  if (!profile) {
    redirect("/");
  }

  const [
    storyResult,
    desksResult,
  ] = await Promise.all([
    supabase
      .from("stories")
      .select(`
        id,
        title,
        slug,
        desk_id,
        story_type,
        status,
        excerpt,
        intro,
        sections,
        hero_image_url,
        hero_image_alt,
        hero_image_credit,
        seo_title,
        meta_description,
        is_breaking,
        is_featured,
        is_exclusive,
        is_trending,
        is_hero,
        audio_url,
        audio_voice_id,
        audio_generated_at,
        publisher_audio_article_id,
        publisher_audio_status
      `)
      .eq("id", id)
      .maybeSingle(),

    supabase
      .from("desks")
      .select("id, name")
      .eq("is_active", true)
      .order("sort_order"),
  ]);

  if (
    storyResult.error ||
    !storyResult.data
  ) {
    notFound();
  }

  if (desksResult.error) {
    throw new Error(
      desksResult.error.message,
    );
  }

  const boundUpdateStory =
    updateStory.bind(
      null,
      id,
    );

  const boundGenerateAudio =
    generateAudioForStory.bind(
      null,
      id,
    );

  const boundSyncAudio =
    syncAudioForStory.bind(
      null,
      id,
    );

  return (
    <div className="min-h-screen bg-neutral-100">
      <AdminHeader />

      <main className="mx-auto max-w-5xl px-6 py-10">
        <Link
          href="/admin"
          className="text-sm font-bold text-black/45 hover:text-black"
        >
          ← Newsroom
        </Link>

        <div className="mt-6 border-b border-black/10 pb-8">
          <div className="text-xs font-black uppercase tracking-[0.2em] text-red-600">
            Story Editor
          </div>

          <h1 className="mt-2 text-4xl font-black tracking-[-0.04em] text-black">
            Edit Story
          </h1>

          <p className="mt-3 text-black/55">
            Update, review and publish this Informant Wire story.
          </p>

          {saved === "1" ? (
            <div className="mt-5 rounded-xl border border-green-200 bg-green-50 px-4 py-3 text-sm font-bold text-green-800">
              Story saved successfully.
            </div>
          ) : null}
        </div>

        {audio === "generated" ? (
          <div className="mt-5 rounded-xl border border-blue-200 bg-blue-50 px-4 py-3 text-sm font-bold text-blue-800">
            Story sent to Publisher Audio. Audio is being generated.
          </div>
        ) : null}

        {audio === "processing" ? (
          <div className="mt-5 rounded-xl border border-blue-200 bg-blue-50 px-4 py-3 text-sm font-bold text-blue-800">
            Publisher Audio is still generating this story.
          </div>
        ) : null}

        {audio === "ready" ? (
          <div className="mt-5 rounded-xl border border-green-200 bg-green-50 px-4 py-3 text-sm font-bold text-green-800">
            Publisher Audio narration is ready.
          </div>
        ) : null}

        <div className="mt-8 rounded-2xl border border-black/10 bg-white p-6 shadow-sm">
          <div className="flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">
            <div>
              <div className="text-xs font-black uppercase tracking-[0.2em] text-red-600">
                Story Audio
              </div>

              <h2 className="mt-2 text-xl font-black tracking-tight text-black">
                Listen to this story
              </h2>

              <p className="mt-1 text-sm text-black/55">
                {storyResult.data.audio_url
                  ? "Narration is ready."
                  : "Narration has not been generated yet."}
              </p>

              {storyResult.data.audio_generated_at ? (
                <p className="mt-1 text-xs text-black/40">
                  Generated{" "}
                  {new Date(
                    storyResult.data.audio_generated_at,
                  ).toLocaleString("en-GB")}
                </p>
              ) : null}
            </div>

            <div className="flex flex-wrap gap-3">
              <form action={boundGenerateAudio}>
                <button
                  type="submit"
                  className="rounded-xl bg-black px-5 py-3 text-sm font-black text-white transition hover:bg-red-600"
                >
                  {storyResult.data.audio_url
                    ? "Regenerate Audio"
                    : "Generate Audio"}
                </button>
              </form>

              {storyResult.data.publisher_audio_article_id &&
              !storyResult.data.audio_url ? (
                <form action={boundSyncAudio}>
                  <button
                    type="submit"
                    className="rounded-xl border border-black/15 bg-white px-5 py-3 text-sm font-black text-black transition hover:border-black"
                  >
                    Check Audio Status
                  </button>
                </form>
              ) : null}
            </div>
          </div>

          {storyResult.data.audio_url ? (
            <audio
              controls
              preload="metadata"
              className="mt-5 w-full"
              src={storyResult.data.audio_url}
            >
              Your browser does not support audio playback.
            </audio>
          ) : null}
        </div>

        <div className="mt-8">
          <StoryEditor
            desks={
              desksResult.data ??
              []
            }
            story={
              storyResult.data
            }
            action={
              boundUpdateStory
            }
            submitLabel="Update Story"
          />
        </div>
      </main>
    </div>
  );
}
